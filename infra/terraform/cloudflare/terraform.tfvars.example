# State backend uses env AWS_PROFILE / default chain (export AWS_PROFILE=7oas7er locally).

# Zone id for 7oas7er.com (also stored as GitHub Environment CLOUDFLARE_ZONE_ID).
# zone_id = "701810fff825f90c0eea671970a0cc9e"

# CloudFront distribution domain names (from envs/*/ terraform output distribution_domain_name).
# Production CNAME: netrunner.7oas7er.com → prod_cloudfront_domain_name
# Staging CNAME: netrunner-stg.7oas7er.com → stg_cloudfront_domain_name
prod_cloudfront_domain_name = "d111111abcdef8.cloudfront.net"
stg_cloudfront_domain_name  = "d222222abcdef8.cloudfront.net"

# Must match the matching AWS env origin_verify_secret (never commit real values).
# Rotation: see infra/terraform/docs/origin-verify-secret-rotation.md
stg_origin_verify_secret  = "replace-with-a-long-random-secret"
prod_origin_verify_secret = "replace-with-a-different-long-random-secret"

# Deploy: CLOUDFLARE_ZONE_ID (same as zone_id) + CLOUDFLARE_API_TOKEN with Zone.Cache Purge
# (plus Zone.Read) in both GitHub Environments.
#
# Terraform API token also needs Zone → Cache Rules → Edit, Transform Rules, DNS,
# and Zone Settings as used by this root (netrunner / netrunner-stg hosts only;
# www/apex remain Netrunner on the shared zone).
