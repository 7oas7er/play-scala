{
  "uid": "netrunner-overview",
  "title": "Netrunner",
  "description": "Synthetics, AWS CloudWatch, Cloudflare edge (GraphQL), and GitHub Actions for Netrunner.",
  "tags": [
    "netrunner",
    "synthetics",
    "observability",
    "cloudflare",
    "github"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 3,
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "includeAll": false,
        "multi": false,
        "refresh": 1,
        "regex": "",
        "skipUrlSync": false
      },
      {
        "name": "loki",
        "type": "datasource",
        "query": "loki",
        "current": {},
        "hide": 0,
        "includeAll": false,
        "multi": false,
        "refresh": 1,
        "regex": "",
        "skipUrlSync": false
      },
      {
        "name": "environment",
        "type": "custom",
        "query": "prod,stg",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "options": [
          {
            "text": "prod",
            "value": "prod",
            "selected": false
          },
          {
            "text": "stg",
            "value": "stg",
            "selected": false
          }
        ]
      },
      {
        "name": "infinity",
        "type": "datasource",
        "query": "yesoreyeram-infinity-datasource",
        "current": {
          "text": "Cloudflare GraphQL",
          "value": "infinity-cloudflare"
        },
        "hide": 0,
        "includeAll": false,
        "multi": false,
        "refresh": 1,
        "regex": "",
        "skipUrlSync": false
      },
      {
        "name": "github",
        "type": "datasource",
        "query": "grafana-github-datasource",
        "current": {
          "text": "GitHub Netrunner",
          "value": "github-netrunner"
        },
        "hide": 0,
        "includeAll": false,
        "multi": false,
        "refresh": 1,
        "regex": "",
        "skipUrlSync": false
      },
      {
        "name": "cf_zone",
        "type": "textbox",
        "label": "CF zoneTag",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        },
        "hide": 0,
        "skipUrlSync": false,
        "description": "Cloudflare zone id (terraform cloudflare output zone_id)."
      },
      {
        "name": "cf_host",
        "type": "custom",
        "label": "CF host",
        "query": "netrunner.7oas7er.com,netrunner-stg.7oas7er.com",
        "current": {
          "text": "netrunner.7oas7er.com",
          "value": "netrunner.7oas7er.com"
        },
        "includeAll": false,
        "multi": false,
        "options": [
          {
            "text": "netrunner.7oas7er.com",
            "value": "netrunner.7oas7er.com",
            "selected": true
          },
          {
            "text": "netrunner-stg.7oas7er.com",
            "value": "netrunner-stg.7oas7er.com",
            "selected": false
          }
        ]
      },
      {
        "name": "gh_owner",
        "type": "textbox",
        "query": "7oas7er",
        "current": {
          "text": "7oas7er",
          "value": "7oas7er"
        },
        "hide": 2
      },
      {
        "name": "gh_repo",
        "type": "textbox",
        "query": "netrunner",
        "current": {
          "text": "netrunner",
          "value": "netrunner"
        },
        "hide": 2
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "name": "GitHub commits",
        "datasource": {
          "type": "grafana-github-datasource",
          "uid": "${github}"
        },
        "enable": true,
        "iconColor": "blue",
        "target": {
          "refId": "Anno",
          "queryType": "Commits",
          "owner": "$gh_owner",
          "repository": "$gh_repo"
        }
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Synthetics \u2014 availability",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "collapsed": false
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Prod site",
      "description": "Average probe_success for netrunner-prod-site",
      "gridPos": {
        "h": 4,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.95
              },
              {
                "color": "green",
                "value": 0.99
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "mean"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "avg(probe_success{project=\"netrunner\", job=\"netrunner-prod-site\"})",
          "legendFormat": "uptime"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Stg site",
      "gridPos": {
        "h": 4,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.95
              },
              {
                "color": "green",
                "value": 0.99
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "mean"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "avg(probe_success{project=\"netrunner\", job=\"netrunner-stg-site\"})",
          "legendFormat": "uptime"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Probe success",
      "description": "1 = success, 0 = failure per check and probe",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "max": 1,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "spanNulls": false,
            "showPoints": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "probe_success{project=\"netrunner\", environment=~\"$environment\"}",
          "legendFormat": "{{job}} / {{probe}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Probe duration",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "spanNulls": false,
            "showPoints": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "probe_duration_seconds{project=\"netrunner\", environment=~\"$environment\"}",
          "legendFormat": "{{job}} / {{probe}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "HTTP status code",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 13
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "spanNulls": false,
            "showPoints": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "probe_http_status_code{project=\"netrunner\", environment=~\"$environment\"}",
          "legendFormat": "{{job}} / {{probe}}"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "HTTP phase latency",
      "description": "DNS / connect / TLS / processing / transfer",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 13
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "spanNulls": false,
            "showPoints": "never",
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "avg by (phase) (probe_http_duration_seconds{project=\"netrunner\", environment=~\"$environment\"})",
          "legendFormat": "{{phase}}"
        }
      ]
    },
    {
      "type": "row",
      "title": "Synthetics \u2014 failure logs",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 21
      },
      "id": 10,
      "collapsed": false
    },
    {
      "id": 11,
      "type": "logs",
      "title": "Synthetic check logs",
      "description": "Loki logs from Synthetic Monitoring agents for Netrunner checks",
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 22
      },
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "options": {
        "showTime": true,
        "showLabels": true,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{source=\"synthetic-monitoring-agent\", project=\"netrunner\", environment=~\"$environment\"}",
          "queryType": "range"
        }
      ]
    },
    {
      "type": "row",
      "title": "AWS CloudWatch",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 32
      },
      "id": 12,
      "collapsed": false
    },
    {
      "id": 13,
      "type": "text",
      "title": "",
      "gridPos": {
        "h": 3,
        "w": 24,
        "x": 0,
        "y": 33
      },
      "options": {
        "mode": "markdown",
        "content": "CloudWatch scrape uses IAM role `shared-netrunner-grafana-cloudwatch-role` (Grafana Labs account `008923505280`). Panels below filter on `project=\"netrunner\"` static labels from the scrape job."
      }
    },
    {
      "id": 16,
      "type": "timeseries",
      "title": "CloudFront requests / errors",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 44
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (Name) (rate(aws_cloudfront_requests_sum{project=\"netrunner\"}[5m]))",
          "legendFormat": "requests {{Name}}"
        },
        {
          "refId": "B",
          "expr": "avg by (Name) (aws_cloudfront_4xx_error_rate_average{project=\"netrunner\"})",
          "legendFormat": "4xx % {{Name}}"
        },
        {
          "refId": "C",
          "expr": "avg by (Name) (aws_cloudfront_5xx_error_rate_average{project=\"netrunner\"})",
          "legendFormat": "5xx % {{Name}}"
        }
      ]
    },
    {
      "id": 17,
      "type": "timeseries",
      "title": "CloudFront bytes downloaded",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 44
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "binBps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (Name) (rate(aws_cloudfront_bytes_downloaded_sum{project=\"netrunner\"}[5m]))",
          "legendFormat": "{{Name}}"
        }
      ]
    },
    {
      "type": "row",
      "title": "Cloudflare edge",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 52
      },
      "id": 20,
      "collapsed": false
    },
    {
      "id": 21,
      "type": "timeseries",
      "title": "Cloudflare edge requests",
      "description": "httpRequestsAdaptiveGroups for the selected host (Infinity \u2192 Cloudflare GraphQL). Requires CF zoneTag dashboard variable and Zone Analytics Read token.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 53
      },
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "${infinity}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "type": "graphql",
          "source": "url",
          "format": "timeseries",
          "url": "https://api.cloudflare.com/client/v4/graphql",
          "url_options": {
            "method": "POST",
            "data": ""
          },
          "parser": "backend",
          "root_selector": "data.viewer.zones.0.httpRequestsAdaptiveGroups",
          "columns": [
            {
              "selector": "dimensions.datetimeHour",
              "text": "Time",
              "type": "timestamp"
            },
            {
              "selector": "count",
              "text": "requests",
              "type": "number"
            }
          ],
          "filters": [],
          "data": "query {\n  viewer {\n    zones(filter: { zoneTag: \"${cf_zone}\" }) {\n      httpRequestsAdaptiveGroups(\n        limit: 2000\n        orderBy: [datetimeHour_ASC]\n        filter: {\n          datetime_geq: \"${__from:date:iso}\"\n          datetime_leq: \"${__to:date:iso}\"\n          clientRequestHTTPHost: \"${cf_host}\"\n        }\n      ) {\n        count\n        dimensions { datetimeHour }\n      }\n    }\n  }\n}"
        }
      ]
    },
    {
      "id": 22,
      "type": "timeseries",
      "title": "Cloudflare edge blocks (HTTP 403)",
      "description": "Free plan cannot use firewallEventsAdaptiveGroups. This panel uses httpRequestsAdaptiveGroups with edgeResponseStatus=403 (managed firewall / WAF blocks). Rate-limit hits may appear as 403/429 here or in the firewall events table.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 53
      },
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "${infinity}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 50,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "type": "graphql",
          "source": "url",
          "format": "timeseries",
          "url": "https://api.cloudflare.com/client/v4/graphql",
          "url_options": {
            "method": "POST",
            "data": ""
          },
          "parser": "backend",
          "root_selector": "data.viewer.zones.0.httpRequestsAdaptiveGroups",
          "columns": [
            {
              "selector": "dimensions.datetimeHour",
              "text": "Time",
              "type": "timestamp"
            },
            {
              "selector": "count",
              "text": "blocks",
              "type": "number"
            }
          ],
          "filters": [],
          "data": "query {\n  viewer {\n    zones(filter: { zoneTag: \"${cf_zone}\" }) {\n      httpRequestsAdaptiveGroups(\n        limit: 2000\n        orderBy: [datetimeHour_ASC]\n        filter: {\n          datetime_geq: \"${__from:date:iso}\"\n          datetime_leq: \"${__to:date:iso}\"\n          clientRequestHTTPHost: \"${cf_host}\"\n          edgeResponseStatus: 403\n        }\n      ) {\n        count\n        dimensions { datetimeHour edgeResponseStatus }\n      }\n    }\n  }\n}"
        },
        {
          "refId": "B",
          "type": "graphql",
          "source": "url",
          "format": "timeseries",
          "url": "https://api.cloudflare.com/client/v4/graphql",
          "url_options": {
            "method": "POST",
            "data": ""
          },
          "parser": "backend",
          "root_selector": "data.viewer.zones.0.httpRequestsAdaptiveGroups",
          "columns": [
            {
              "selector": "dimensions.datetimeHour",
              "text": "Time",
              "type": "timestamp"
            },
            {
              "selector": "count",
              "text": "429",
              "type": "number"
            }
          ],
          "filters": [],
          "data": "query {\n  viewer {\n    zones(filter: { zoneTag: \"${cf_zone}\" }) {\n      httpRequestsAdaptiveGroups(\n        limit: 2000\n        orderBy: [datetimeHour_ASC]\n        filter: {\n          datetime_geq: \"${__from:date:iso}\"\n          datetime_leq: \"${__to:date:iso}\"\n          clientRequestHTTPHost: \"${cf_host}\"\n          edgeResponseStatus: 429\n        }\n      ) {\n        count\n        dimensions { datetimeHour edgeResponseStatus }\n      }\n    }\n  }\n}"
        }
      ]
    },
    {
      "type": "row",
      "title": "GitHub Actions CI",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 69
      },
      "id": 30,
      "collapsed": false
    },
    {
      "id": 31,
      "type": "table",
      "title": "Deploy workflow runs",
      "description": "Recent runs of deploy-netrunner.yml (tests + deploy).",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 70
      },
      "datasource": {
        "type": "grafana-github-datasource",
        "uid": "${github}"
      },
      "options": {
        "showHeader": true
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "Workflow_Runs",
          "owner": "$gh_owner",
          "repository": "$gh_repo",
          "workflow": "deploy-netrunner.yml"
        }
      ]
    },
    {
      "id": 32,
      "type": "table",
      "title": "Terraform plan workflow runs",
      "description": "Recent runs of terraform-plan.yml.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 70
      },
      "datasource": {
        "type": "grafana-github-datasource",
        "uid": "${github}"
      },
      "options": {
        "showHeader": true
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "Workflow_Runs",
          "owner": "$gh_owner",
          "repository": "$gh_repo",
          "workflow": "terraform-plan.yml"
        }
      ]
    },
    {
      "id": 33,
      "type": "table",
      "title": "Deploy workflow usage",
      "description": "Success/failure rates and duration for deploy-netrunner.yml in the selected range.",
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 0,
        "y": 78
      },
      "datasource": {
        "type": "grafana-github-datasource",
        "uid": "${github}"
      },
      "options": {
        "showHeader": true
      },
      "targets": [
